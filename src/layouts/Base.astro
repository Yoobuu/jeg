---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'JEG Remodeling Concepts Corp — Premium Remodeling in Orlando, FL',
  description = 'Family-owned remodeling in Orlando, FL. Bathrooms, kitchens, flooring, seamless gutters, porch enclosures and painting — built with premium materials and meticulous detail. Free quote: +1 407 558-6109.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const abs = (p) => new URL(base + p, Astro.site ?? Astro.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: 'JEG Remodeling Concepts Corp.',
  image: abs('img/gal-01.jpg'),
  url: canonical,
  telephone: '+14075586109',
  email: 'remodelingconcepts09@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Orlando', addressRegion: 'FL', addressCountry: 'US' },
  areaServed: 'Greater Orlando, FL',
  openingHours: 'Mo-Sa 07:00-18:30',
  priceRange: '$$',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '8' },
  knowsAbout: ['Bathroom remodeling', 'Kitchen remodeling', 'Flooring', 'Seamless aluminum gutters', 'Screen & porch enclosures', 'Painting'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161311" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={abs('img/gal-01.jpg')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Heebo:wght@300;400;500;600;700&family=Shadows+Into+Light&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Reveal on scroll
        const reveals = document.querySelectorAll('.reveal');
        if (reduce) {
          reveals.forEach((el) => el.classList.add('in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries)
                if (e.isIntersecting) {
                  e.target.classList.add('in');
                  io.unobserve(e.target);
                }
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
          );
          reveals.forEach((el) => io.observe(el));
        }

        // Count-up stats
        const counters = document.querySelectorAll('[data-count]');
        const setFinal = (el) => {
          const t = parseInt(el.dataset.count, 10);
          el.textContent = t.toLocaleString('en-US') + (el.dataset.suffix || '');
        };
        if (reduce) {
          counters.forEach(setFinal);
        } else {
          const co = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (!e.isIntersecting) continue;
                const el = e.target;
                const target = parseInt(el.dataset.count, 10);
                const suffix = el.dataset.suffix || '';
                const dur = 1500;
                const start = performance.now();
                const tick = (now) => {
                  const p = Math.min(1, (now - start) / dur);
                  const eased = 1 - Math.pow(1 - p, 3);
                  el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
                  if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
                co.unobserve(el);
              }
            },
            { threshold: 0.5 }
          );
          counters.forEach((el) => co.observe(el));
        }

        // Quote form → mailto (works with no backend; EmailJS can replace later)
        const form = document.getElementById('quote-form');
        if (form) {
          form.addEventListener('submit', (ev) => {
            ev.preventDefault();
            const f = new FormData(form);
            const name = (f.get('name') || '').toString().trim();
            const phone = (f.get('phone') || '').toString().trim();
            const service = (f.get('service') || '').toString();
            const message = (f.get('message') || '').toString().trim();
            const subject = encodeURIComponent(`Quote request — ${service || 'Remodeling'}${name ? ' — ' + name : ''}`);
            const body = encodeURIComponent(
              `Name: ${name}\nPhone: ${phone}\nService: ${service}\n\n${message}`
            );
            window.location.href = `mailto:remodelingconcepts09@gmail.com?subject=${subject}&body=${body}`;
            const ok = document.getElementById('quote-ok');
            if (ok) ok.hidden = false;
          });
        }

        // Living interactions (skipped when reduced-motion)
        if (!reduce) {
          // Magnetic buttons
          document.querySelectorAll('.mag').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              el.style.setProperty('--mx', (e.clientX - r.left - r.width / 2) * 0.22 + 'px');
              el.style.setProperty('--my', (e.clientY - r.top - r.height / 2) * 0.22 + 'px');
            });
            el.addEventListener('pointerleave', () => {
              el.style.setProperty('--mx', '0px');
              el.style.setProperty('--my', '0px');
            });
          });
          // Tilt cards
          document.querySelectorAll('.tilt').forEach((el) => {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              const px = (e.clientX - r.left) / r.width - 0.5;
              const py = (e.clientY - r.top) / r.height - 0.5;
              el.style.setProperty('--ry', px * 5.5 + 'deg');
              el.style.setProperty('--rx', -py * 5.5 + 'deg');
            });
            el.addEventListener('pointerleave', () => {
              el.style.setProperty('--rx', '0deg');
              el.style.setProperty('--ry', '0deg');
            });
          });
          // Decorative parallax
          const par = document.querySelectorAll('[data-parallax]');
          if (par.length) {
            let ticking = false;
            window.addEventListener('scroll', () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(() => {
                const y = window.scrollY;
                par.forEach((el) => {
                  el.style.transform = `translate3d(0, ${y * (parseFloat(el.dataset.parallax) || 0.12)}px, 0)`;
                });
                ticking = false;
              });
            }, { passive: true });
          }
        }

        // Before / after sliders (pointer + hover)
        document.querySelectorAll('.ba').forEach((ba) => {
          const set = (clientX) => {
            const r = ba.getBoundingClientRect();
            let p = ((clientX - r.left) / r.width) * 100;
            ba.style.setProperty('--pos', Math.max(2, Math.min(98, p)) + '%');
          };
          let down = false;
          ba.addEventListener('pointerdown', (e) => { down = true; ba.setPointerCapture(e.pointerId); set(e.clientX); });
          ba.addEventListener('pointermove', (e) => { if (down || e.pointerType === 'mouse') set(e.clientX); });
          ba.addEventListener('pointerup', () => { down = false; });
        });

        // Gallery carousel — auto-rotate, arrows, dots, keyboard, pause on hover
        document.querySelectorAll('[data-carousel]').forEach((car) => {
          const slides = [...car.querySelectorAll('.car-slide')];
          const dots = [...car.querySelectorAll('.car-dot')];
          const count = car.querySelector('.car-count');
          if (slides.length < 2) return;
          let idx = 0;
          let timer = null;
          const render = (n) => {
            slides[idx].classList.remove('active');
            slides[idx].setAttribute('aria-hidden', 'true');
            if (dots[idx]) dots[idx].classList.remove('active');
            idx = (n + slides.length) % slides.length;
            slides[idx].classList.add('active');
            slides[idx].setAttribute('aria-hidden', 'false');
            if (dots[idx]) dots[idx].classList.add('active');
            if (count) count.textContent = String(idx + 1).padStart(2, '0') + ' / ' + String(slides.length).padStart(2, '0');
          };
          let userPaused = false;
          const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
          const start = () => { if (!reduce && !userPaused) { stop(); timer = setInterval(() => render(idx + 1), 5000); } };
          const pauseBtn = car.querySelector('.car-pause');
          if (pauseBtn) {
            const PAUSE = '<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>';
            const PLAY = '<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
            pauseBtn.innerHTML = PAUSE;
            pauseBtn.addEventListener('click', () => {
              userPaused = !userPaused;
              pauseBtn.setAttribute('aria-pressed', String(userPaused));
              pauseBtn.setAttribute('aria-label', userPaused ? 'Play gallery' : 'Pause gallery');
              pauseBtn.innerHTML = userPaused ? PLAY : PAUSE;
              if (userPaused) stop(); else start();
            });
          }
          car.addEventListener('focusin', stop);
          car.addEventListener('focusout', () => { setTimeout(() => { if (!car.contains(document.activeElement)) start(); }, 0); });
          car.querySelector('.car-next').addEventListener('click', () => { render(idx + 1); start(); });
          car.querySelector('.car-prev').addEventListener('click', () => { render(idx - 1); start(); });
          dots.forEach((d, n) => d.addEventListener('click', () => { render(n); start(); }));
          car.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') { render(idx + 1); start(); }
            else if (e.key === 'ArrowLeft') { render(idx - 1); start(); }
          });
          car.addEventListener('pointerenter', stop);
          car.addEventListener('pointerleave', start);
          car.querySelectorAll('.car-slide').forEach((s) => {
            s.addEventListener('click', (e) => {
              if (e.target.closest('.car-arrow') || e.target.closest('.car-dot')) return;
              if (window.__openLightbox) window.__openLightbox(slides.indexOf(car.querySelector('.car-slide.active')));
            });
          });
          start();
        });

        // Lightbox (fullscreen gallery viewer)
        const lb = document.getElementById('lightbox');
        if (lb) {
          const lbImg = document.getElementById('lb-img');
          const lbCap = document.getElementById('lb-cap');
          const figs = [...document.querySelectorAll('.car-slide')];
          const items = figs.map((f) => ({ full: f.dataset.full, cap: f.dataset.cap || '' }));
          let li = 0;
          const show = (n) => {
            li = (n + items.length) % items.length;
            lbImg.src = items[li].full;
            lbCap.textContent = items[li].cap + ' · Orlando, FL';
          };
          const close = () => { lb.classList.remove('open'); document.body.style.overflow = ''; };
          window.__openLightbox = (n) => { show(n); lb.classList.add('open'); document.body.style.overflow = 'hidden'; };
          document.getElementById('lb-close').addEventListener('click', close);
          document.getElementById('lb-next').addEventListener('click', () => show(li + 1));
          document.getElementById('lb-prev').addEventListener('click', () => show(li - 1));
          lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
          document.addEventListener('keydown', (e) => {
            if (!lb.classList.contains('open')) return;
            if (e.key === 'Escape') close();
            else if (e.key === 'ArrowRight') show(li + 1);
            else if (e.key === 'ArrowLeft') show(li - 1);
          });
        }

        // Mobile "Call now" FAB — appears once the hero scrolls away
        const fab = document.getElementById('callfab');
        const hero = document.querySelector('main > section');
        if (fab && hero) {
          new IntersectionObserver((entries) => {
            fab.classList.toggle('show', !entries[0].isIntersecting);
          }, { threshold: 0 }).observe(hero);
        }
      })();
    </script>
  </body>
</html>
